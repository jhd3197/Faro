# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
build/

# Tauri
src-tauri/target/
src-tauri/gen/schemas/
src-tauri/WixTools/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Env
.env
.env.local
.env.*.local

# Misc
*.tsbuildinfo
.eslintcache
*.png
/.claude/skills

# Local planning and PR drafts
docs/plans/
**/plans/
*-pr-body.md
pr-body.md

# PR description drafts from the create-pr skill (local scratch, not shipped)
.pr/

# Marketing drafts / channel notes (local scratch, not shipped)
.marketing/

# Generated demo screenshots — rebuild with `npm run shots` (already covered by
# the global *.png rule above; listed explicitly so the intent is clear).
docs/screenshots/*.png

# …except the README poster and the funding QR codes — these are real
# committed assets (same as ServerKit).
!docs/screenshots/poster.png
!docs/images/funding/*.png

# Tauri updater signing key (Plan 16) — PRIVATE key, never commit. Belongs in
# CI secret TAURI_SIGNING_PRIVATE_KEY. See docs/updater-key-custody.md.
.updater/
/graphify-out

# Python (test mocks bytecode cache)
__pycache__/
*.pyc
