{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Faro",
  "version": "1.3.38",
  "identifier": "com.juandenis.faro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "faro"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/jhd3197/Faro/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4MzQ2NEEwRDBENEE5OTcKUldTWHFkVFFvR1EwR0s3NGpQeEcvcEptVUNqanFZdXNsQVF1dFBnNHhqalpLWVQvcnhsTy9mVHYK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
